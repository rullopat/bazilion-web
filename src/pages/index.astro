---
import '../styles/global.css';

const features = [
  {
    n: '01',
    title: 'Profiles become Agents',
    body: 'A profile is an Agent template: SOUL.md, IDENTITY.md, AGENTS.md, TOOLS.md, a default model and skills. Spawning one makes an Agent in a Team.',
  },
  {
    n: '02',
    title: 'Teams share a workspace',
    body: 'A Team is a directory, or a link to your project, with a USER.md about you, shared memory and its members. Team templates spawn a whole Team at once.',
  },
  {
    n: '03',
    title: 'Simple messaging policy',
    body: 'An open Team lets members message each other freely; a restricted one needs an allow edge. You can always chat with every Agent.',
  },
  {
    n: '04',
    title: 'A mailbox between agents',
    body: 'send_message, read_inbox and wait_for_reply inside the loop; an idle Agent with unread mail wakes up, and a hop limit stops message loops.',
  },
  {
    n: '05',
    title: 'Shared memory, indexed by qmd',
    body: 'One <team>/memory per Team, searched with qmd BM25 over Markdown, so decisions outlive the chat that produced them.',
  },
  {
    n: '06',
    title: 'Schedules that run once',
    body: 'Interval and cron triggers wake an Agent with a stored instruction. Each occurrence runs once; failures show in Attention with the real error.',
  },
  {
    n: '07',
    title: 'Coding on the host or in Docker',
    body: 'Agents run bash and file tools in the Team directory, guided by the repository\'s AGENTS.md. One setting moves every turn into a network-less Docker sandbox.',
  },
  {
    n: '08',
    title: 'Watch it work, review the diff',
    body: 'Tool output streams live into the chat. The Team Review page shows the Git changes since any base and sends file feedback to an Agent.',
  },
  {
    n: '09',
    title: 'Research, browse, connect',
    body: 'Web search and fetch, a managed browser per Agent, MCP servers and image generation, with the same tools on every kind of turn.',
  },
  {
    n: '10',
    title: 'Results and conversations persist',
    body: 'Delivered files and generated images are saved as Team results. Earlier conversations stay readable when you start a new one.',
  },
  {
    n: '11',
    title: 'Follow-ups, questions, Telegram',
    body: 'Queue messages while an Agent works, answer its questions mid-turn, and talk to every Agent in its own Telegram topic.',
  },
  {
    n: '12',
    title: 'Pi underneath, your machine around it',
    body: 'Pi runs the turn loop, transcript and coding tools. One daemon owns ~/.bazilion; the web UI and the CLI offer the same features.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/baziu.svg" />
    <meta name="theme-color" content="#F5F0E8" />

    <title>Bazilion — personal open source multi-agent runtime</title>
    <meta
      name="description"
      content="Bazilion is Patrizio Rullo's MIT-licensed, local multi-agent runtime for one person, built on Pi's coding agent — Agents in Teams with a shared workspace, memory and mailbox, on schedules, from a web UI, a CLI and Telegram."
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Bazilion — personal open source multi-agent runtime" />
    <meta
      property="og:description"
      content="MIT-licensed and local, built on Pi's coding agent. Teams of Agents with a shared workspace, memory and mailbox, schedules, coding on the host or in Docker, and saved results."
    />
    <meta property="og:url" content="https://bazilion.com" />
    <meta property="og:image" content="https://bazilion.com/baziu.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <!-- ───────────── nav ───────────── -->
      <nav class="nav" data-reveal="1">
        <a href="/" class="mark" aria-label="Bazilion home">
          Baz<span class="dot" aria-hidden="true"></span>lion
        </a>
        <ul role="list">
          <li><a href="#manifesto">why</a></li>
          <li><a href="#library">features</a></li>
          <li><a href="#agents">templates</a></li>
          <li><a href="#install">install</a></li>
          <li><a href="/docs">docs</a></li>
          <li><a href="https://github.com/rullopat/bazilion" rel="noreferrer">github ↗</a></li>
        </ul>
      </nav>

      <a class="release-note" href="/docs/whats-new/" data-reveal="2">
        <span class="release-note__badge">v0.26.0</span>
        <span>
          Simplified for one local operator. Back up your home and start fresh to upgrade.
        </span>
        <span class="release-note__arrow" aria-hidden="true">read what changed →</span>
      </a>

      <!-- ───────────── hero ───────────── -->
      <header class="hero">
        <div>
          <div class="hero__supra" data-reveal="2">
            built on Pi · your machine, your keys
          </div>
          <h1 class="hero__wordmark" data-reveal="3">
            Baz<span class="ink-eye">i</span>lion
          </h1>
          <p class="hero__lede" data-reveal="4">
            An MIT-licensed runtime <br />for <em>agent teams</em>, <br />living on your machine.
          </p>
          <div class="hero__meta" data-reveal="5">
            <a class="hero__cta" href="#install">
              <span>install bazilion</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="hero__link" href="https://github.com/rullopat/bazilion/blob/main/LICENSE" rel="noreferrer">MIT license ↗</a>
          </div>
        </div>

        <figure class="hero__portrait" data-reveal="4">
          <img
            src="/baziu.svg"
            alt="Baziu — a Neva Masquerade cat, portrait used as the Bazilion mark"
            width="460"
            height="460"
            fetchpriority="high"
          />
          <figcaption class="caption">
            Baziu, <span>♡</span> 2007 — 2025
          </figcaption>
        </figure>
      </header>

      <!-- ───────────── install ───────────── -->
      <section class="section quickstart" id="install">
        <div class="section__label">Quick start</div>
        <h2 class="section__title">
          One-line install, npm, or source. <em>The dashboard opens locally</em>.
        </h2>

        <div class="install-tabs">
          <input class="install-tabs__input" type="radio" name="install-method" id="install-macos" checked />
          <input class="install-tabs__input" type="radio" name="install-method" id="install-npm" />
          <input class="install-tabs__input" type="radio" name="install-method" id="install-hackable" />

          <div class="install-tabs__nav" aria-label="Installation methods">
            <label class="install-tabs__tab" for="install-macos">Linux / macOS</label>
            <label class="install-tabs__tab" for="install-npm">npm</label>
            <label class="install-tabs__tab" for="install-hackable">Hackable</label>
          </div>

          <div class="install-tabs__panels">
            <div class="install-tabs__panel install-tabs__panel--macos">
              <div class="card-code">
                <div class="card-code__head">
                  <span>one-line installer</span>
                </div>
<pre><span class="c-comment"># Installs supported Node if needed, then bazilion.</span>
<span class="c-prompt">$</span> <span class="c-cmd">curl</span> <span class="c-flag">-fsSL</span> \
  https://bazilion.com/install.sh \
  | bash

<span class="c-comment"># Then open the local web dashboard.</span>
<span class="c-prompt">$</span> <span class="c-cmd">bazilion</span> <span class="c-cmd">dashboard</span></pre>
              </div>
            </div>

            <div class="install-tabs__panel install-tabs__panel--npm">
              <div class="card-code">
                <div class="card-code__head">
                  <span>daemon + web UI</span>
                </div>
<pre><span class="c-comment"># Requires Node ^26.12.1.</span>
<span class="c-prompt">$</span> <span class="c-cmd">npm</span> <span class="c-cmd">install</span> <span class="c-flag">-g</span> <span class="c-cmd">bazilion</span>
<span class="c-prompt">$</span> <span class="c-cmd">bazilion</span> <span class="c-cmd">dashboard</span>
<span class="c-ok">*</span> daemon <span class="c-flag">127.0.0.1:4321</span>
<span class="c-ok">*</span> dashboard <span class="c-flag">127.0.0.1:4322</span>
<span class="c-ok">*</span> workspace <span class="c-flag">~/.bazilion</span></pre>
              </div>
            </div>

            <div class="install-tabs__panel install-tabs__panel--hackable">
              <div class="card-code">
                <div class="card-code__head">
                  <span>source checkout</span>
                </div>
<pre><span class="c-comment"># For people who want to read and change the code.</span>
<span class="c-prompt">$</span> <span class="c-cmd">git</span> <span class="c-cmd">clone</span> https://github.com/rullopat/bazilion
<span class="c-prompt">$</span> <span class="c-cmd">cd</span> bazilion
<span class="c-prompt">$</span> <span class="c-cmd">mise</span> <span class="c-cmd">install</span> <span class="c-comment"># Node 26.12.1 and pnpm 12.15.0</span>
<span class="c-prompt">$</span> <span class="c-cmd">pnpm</span> <span class="c-cmd">install</span>

<span class="c-comment"># Start the source daemon, then run the web UI in another terminal.</span>
<span class="c-prompt">$</span> <span class="c-cmd">pnpm</span> <span class="c-cmd">tsx</span> apps/cli/src/index.ts serve
<span class="c-prompt">$</span> <span class="c-cmd">cd</span> apps/web && <span class="c-cmd">pnpm</span> <span class="c-cmd">dev</span></pre>
              </div>
            </div>
          </div>
        </div>
      </section>

      <p class="showcase__copy">
        Linux is the tested platform; macOS runs commands on the host and is untested.
        Upgrading from an earlier release? A 0.25 home is refused: back it up, run
        <code>bazilion uninstall --yes</code> and start fresh, as the
        <a href="/docs/getting-started/#upgrade-to-0260">0.26.0 upgrade steps</a> describe.
      </p>

      <!-- ───────────── manifesto ───────────── -->
      <section class="section" id="manifesto">
        <div class="section__label">Personal open source</div>
        <h2 class="section__title">
          A runtime I built because I wanted agents that <em>stayed home</em>.
        </h2>

        <div class="manifesto">
          <div class="manifesto__body">
            <p class="dropcap">
              Bazilion is my personal open source multi-agent runtime for one
              person. The engine is Pi's coding agent; Bazilion wraps it in one
              daemon, a CLI, a web UI and a Telegram bot, with Teams, shared memory,
              a mailbox and schedules.
            </p>
            <p>
              A profile defines one kind of agent; a Team template lists the
              Agents of a whole Team and who may message whom. Spawning one puts
              its Agents in a single Team with one workspace, one USER.md, one
              memory and one mailbox, on your machine and with your own keys.
            </p>
          </div>

          <aside class="manifesto__aside">
            <strong>Engine credit</strong>
            Built on <code>@earendil-works/pi-coding-agent</code>, with
            Bazilion orchestration around Pi's session, transcript, tool loop,
            and coding tools.
          </aside>
        </div>
      </section>

      <!-- ───────────── library / features ───────────── -->
      <section class="section" id="library">
        <div class="section__label">Core ideas</div>
        <h2 class="section__title">
          The pieces that make agent collaboration <em>concrete</em>.
        </h2>

        <ol class="library" role="list">
          {features.map((f) => (
            <li class="library__item">
              <div class="library__num">{f.n}</div>
              <div>
                <h3 class="library__title">{f.title}</h3>
                <p class="library__desc">{f.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ───────────── agent showcase ───────────── -->
      <section class="section" id="agents">
        <div class="section__label">Templates</div>
        <h2 class="section__title">
          Profiles describe agents. Team templates describe a <em>whole team</em>.
        </h2>

        <div class="showcase">
          <div class="showcase__left">
            <p class="showcase__lead">
              Write the roles once.<br />
              Decide who may message whom.<br />
              Spawn the whole Team.
            </p>
            <p class="showcase__copy">
              A profile is the reusable role; a Team template is the reusable
              roster, with allow edges and an open or restricted mode. Spawn it into
              a Team from the web UI, the CLI or Telegram, edit the live Team's
              policy, and save a Team as a new template.
            </p>
          </div>

          <div>
            <div class="card-code">
              <div class="card-code__head">
                <span>team template</span>
                <span class="pill">cli</span>
              </div>
<pre><span class="c-prompt">$</span> <span class="c-cmd">bazilion</span> <span class="c-cmd">team-template</span> <span class="c-cmd">show</span> <span class="c-flag">release-review</span>
<span class="c-comment"># release-review — Release review</span>
mode:  <span class="c-ok">restricted</span>

slot  profile          Agent name  model  reasoning
0     docs-reviewer    reader      -      high
1     cli-tester       tester      -      medium
2     release-captain  maintainer  -      high</pre>
            </div>

            <div class="card-code">
              <div class="card-code__head">
                <span>live Team policy</span>
                <span class="pill">team</span>
              </div>
<pre><span class="c-prompt">$</span> <span class="c-cmd">bazilion</span> <span class="c-cmd">team</span> <span class="c-cmd">policy</span> <span class="c-cmd">show</span> <span class="c-flag">release</span>
<span class="c-comment"># Team release policy</span>
mode:    <span class="c-ok">restricted</span> (members need an allow edge)
members: <span class="c-flag">reader, tester, maintainer</span>

from        to
reader      maintainer
tester      maintainer
maintainer  <span class="c-rose">outside</span></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ───────────── rail ───────────── -->
      <section class="section">
        <div class="section__label">How shared context works</div>
        <h2 class="section__title">
          USER.md, memory, and policy make the Team <em>coherent</em>.
        </h2>

        <div class="rail">
          <div class="rail__cell">
            <h4>USER.md is shared</h4>
            <p>
              Each Team has one USER.md about you, the project, your preferences
              and standing instructions. It is added to every member's system
              prompt; you edit it on the Team page, and Agents update it with
              their own tool.
            </p>
          </div>
          <div class="rail__cell">
            <h4>Memory is searchable markdown</h4>
            <p>
              Team memory is qmd-backed: BM25 over markdown under the Team memory
              folder. Agents write a decision once and retrieve it by search
              instead of relying on chat history.
            </p>
          </div>
          <div class="rail__cell">
            <h4>Communication is explicit</h4>
            <p>
              An open Team lets its members message each other freely; a
              restricted one needs an allow edge for each direction. A denied
              message returns an error to the sender. You can always reach every
              Agent.
            </p>
          </div>
        </div>
      </section>

      <!-- ───────────── dedication ───────────── -->
      <section class="section">
        <div class="dedication">
          <div class="glyph" aria-hidden="true">⁂</div>
          <p>
            <strong>Bazilion takes its name and its face</strong> from a Neva
            Masquerade cat who lived with us for eighteen and a half years and
            left in 2025.
          </p>
          <p>
            He was sweet, cuddly, and sharper than he had any right to be — with
            a temper, especially at the vet and especially when we had been gone
            too long. He met us at the door, and let us hear about it when we had
            kept him waiting.
          </p>
          <p>
            I wanted a runtime that worked a little like that: living on its own
            machine, doing small useful things in the background, keeping track
            of who was home. So I named it after him and put his portrait on the
            box.
          </p>
          <div class="sig">in memoriam · Baziu · the original local agent</div>
        </div>
      </section>

      <!-- ───────────── footer ───────────── -->
      <footer class="footer">
        <div class="mark">Baz<span class="ink-eye">i</span>lion</div>
        <div class="footer__meta">
          <div class="row">
            <a href="/docs">docs</a>
            <a href="https://github.com/rullopat/bazilion" rel="noreferrer">github</a>
            <a href="#manifesto">why</a>
            <a href="https://www.patriziorullo.com/" rel="noreferrer">built by Patrizio Rullo ↗</a>
          </div>
          <div>© 2026 Patrizio Rullo · MIT licensed · <span class="imo">made slowly, in memory of a cat.</span></div>
        </div>
      </footer>
    </div>

    <script is:inline>
      // light intersection-observer reveal for sections below the fold.
      (function () {
        if (typeof IntersectionObserver === 'undefined') return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;

        const targets = document.querySelectorAll('section.section');
        targets.forEach((el) => el.classList.add('in-view-hidden'));

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.remove('in-view-hidden');
                e.target.classList.add('in-view-shown');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
