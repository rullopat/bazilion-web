# HTML points at content-hashed Astro assets. Never retain a document across
# Workers asset versions, or it can reference a stylesheet that no longer exists.
/
  Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/docs/*
  Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/releases/*
  Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Fingerprinted build assets are safe to cache permanently.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
